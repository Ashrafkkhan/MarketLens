# Database Connection URL (PostgreSQL using psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/marketlens

# Database Pool Settings (Optional overrides)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Groq (fast chat tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
